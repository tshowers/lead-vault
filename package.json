{
  "name": "lead-vault",
  "version": "0.0.5",
  "scripts": {
    "ng": "ng",
    "generate-version": "node scripts/generate-version.js",
    "bump-version": "node scripts/bump-version.js",
    "prestart": "npm run generate-version",
    "start": "ng serve",
    "prebuild": "npm run bump-version && npm run generate-version",
    "build": "ng build",
    "postbuild": "cp dist/lead-vault/browser/index.csr.html dist/lead-vault/browser/index.html",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate-version",
    "test": "ng test",
    "serve:ssr:lead-vault": "node dist/lead-vault/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/google-maps": "^19.2.7",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/platform-server": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@angular/ssr": "^19.2.27",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@taliferro/ui": "file:../../taliferro-ui",
    "bootstrap": "^5.3.8",
    "express": "^4.18.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.18.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.4",
    "@angular/cli": "^19.0.4",
    "@angular/compiler-cli": "^19.0.0",
    "@types/express": "^4.17.17",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.6.2"
  }
}
